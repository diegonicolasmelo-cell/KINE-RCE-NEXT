 "ocupada": "<div class=\"bcard occ\">\n        <div class=\"bhdr\">\n          <span class=\"bnum\"><div class=\"bdot d-busy\"></div>Cama 1</span>\n          <button class=\"bmov\" onclick=\"mover('1')\" title=\"Mover este paciente a otra cama\">\n            <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\"><path d=\"M17 3l4 4-4 4\"></path><path d=\"M3 7h18\"></path><path d=\"M7 21l-4-4 4-4\"></path><path d=\"M21 17H3\"></path></svg>\n          </button>\n        </div>\n        <div class=\"bbody\">\n          \n          <div class=\"pname\" title=\"Rosa Elena Contreras Pino\"><span>Rosa Elena Contreras Pino</span><button type=\"button\" class=\"pname-lap\" title=\"Editar la ficha del paciente (nombre, RUT, diagnóstico, evaluaciones de ingreso)\" onclick=\"event.stopPropagation();abrirPanel('1',false,true)\">✏️</button></div><div class=\"ep-escalas\" style=\"display:flex;gap:4px;flex-wrap:wrap;margin-top:3px;\"><span class=\"abadge a-pend\" style=\"cursor:pointer;\" title=\"Escala clínica de fragilidad (pre-UCI) — pendiente en este episodio. Toca para medir\" onclick=\"event.stopPropagation();escalaDesdeTarjeta('1','ecf')\">📋 ECF pend.</span><span class=\"abadge a-pend\" style=\"cursor:pointer;\" title=\"Índice de Barthel (pre-UCI) — pendiente en este episodio. Toca para medir\" onclick=\"event.stopPropagation();escalaDesdeTarjeta('1','barthel')\">📋 Barthel pend.</span><span class=\"abadge a-pend\" style=\"cursor:pointer;\" title=\"Índice de Charlson (comorbilidad) — pendiente en este episodio. Toca para medir\" onclick=\"event.stopPropagation();escalaDesdeTarjeta('1','charlson')\">📋 Charlson pend.</span></div>\n          <div style=\"font-size:.78rem;color:var(--muted);\">74a · F</div>\n          \n          <div class=\"bdx\" title=\"Neumonía grave adquirida en la comunidad\">Neumonía grave adquirida en la comunidad</div>\n          <div style=\"display:flex;gap:5px;margin-top:4px;flex-wrap:wrap;\">\n            <span class=\"pill pill-d\">Día 8</span>\n            <span class=\"pill\">TOT</span>\n            \n          </div>\n          <div style=\"display:flex;gap:4px;flex-wrap:wrap;margin-top:5px;\"><span class=\"abadge\" style=\"background:#64748b14;color:#64748b;border:1px solid #64748b44;\" title=\"Sin medir: cooperación sin registrar\">📋 MRC/FSS no evaluables aún</span></div>\n        </div>\n        <div class=\"bfoot\">\n          <button class=\"bevo\" onclick=\"abrirPanel('1',false)\">📝 Evolución</button>\n          <button class=\"btl\" onclick=\"abrirTL('1')\">⏱️ Hist.</button>\n          <button type=\"button\" class=\"btl ev-cand\" title=\"Anotar evento posterior (procedimiento, filtro, cultivo…)\" onclick=\"evAbrir('1',this,'p1')\"><span class=\"ev-mas\">➕</span><span class=\"ev-cerr\">🔒</span></button>\n          <button class=\"balt\" onclick=\"egreso('1')\">🏠 Egr.</button>\n        </div></div>",
